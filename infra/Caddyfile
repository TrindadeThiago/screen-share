{$DOMAIN} {
	encode gzip

	# API de salas
	handle /rooms* {
		reverse_proxy api:3000
	}
	handle /config {
		reverse_proxy api:3000
	}
	handle /version {
		reverse_proxy api:3000
	}

	# Página de download do .exe
	handle /download/* {
		root * /srv/site
		file_server
	}
	handle {
		root * /srv/site
		file_server
	}
}

# Sinalização WebSocket do LiveKit
live.{$DOMAIN} {
	reverse_proxy livekit:7880
}
