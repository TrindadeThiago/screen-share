{$DOMAIN} {
	encode gzip

	# API de salas
	handle /rooms* {
		reverse_proxy api:3000
	}
	handle /config {
		reverse_proxy api:3000
	}

	# Página de download (o .exe vem da última release no GitHub)
	handle {
		root * /srv/site
		file_server
	}
}

# Sinalização WebSocket do LiveKit
live.{$DOMAIN} {
	reverse_proxy livekit:7880
}
